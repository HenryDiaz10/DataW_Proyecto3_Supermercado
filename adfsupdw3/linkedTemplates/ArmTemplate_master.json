{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adfsupdw3"
		},
		"LS_ADLS_Destino_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"LS_ADLS_Destino\""
		},
		"LS_Azure_SQL_Origen_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"LS_Azure_SQL_Origen\""
		},
		"LS_ADLS_Destino_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://datalakesupdw3.dfs.core.windows.net/"
		},
		"LS_Azure_SQL_Origen_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "henryserverdw.database.windows.net"
		},
		"LS_Azure_SQL_Origen_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Sup_dw3_OLTP"
		},
		"LS_Azure_SQL_Origen_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "henry"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI de la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas."
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Token de SAS para la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfsupdw3_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_Destino_accountKey": {
						"value": "[parameters('LS_ADLS_Destino_accountKey')]"
					},
					"LS_Azure_SQL_Origen_password": {
						"value": "[parameters('LS_Azure_SQL_Origen_password')]"
					},
					"LS_ADLS_Destino_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Destino_properties_typeProperties_url')]"
					},
					"LS_Azure_SQL_Origen_properties_typeProperties_server": {
						"value": "[parameters('LS_Azure_SQL_Origen_properties_typeProperties_server')]"
					},
					"LS_Azure_SQL_Origen_properties_typeProperties_database": {
						"value": "[parameters('LS_Azure_SQL_Origen_properties_typeProperties_database')]"
					},
					"LS_Azure_SQL_Origen_properties_typeProperties_userName": {
						"value": "[parameters('LS_Azure_SQL_Origen_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}